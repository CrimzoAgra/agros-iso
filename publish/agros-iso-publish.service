[Unit]
Description=Publish a new AgrOS ISO when agros-iso or AgrOS's packages changed
Wants=network-online.target
After=network-online.target
# (not on battery: 30 minutes of building)
ConditionACPower=true

[Service]
Type=oneshot
Environment=AGROS_PUBLISH_USER=@USER@
ExecStart=/usr/local/lib/agros-iso-publish/agros-iso-publish
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=4h
