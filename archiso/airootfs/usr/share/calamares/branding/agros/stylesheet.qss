/*
 * AgrOS's installer in the desktop's style (Caelestia's: Material 3, dark): its colour scheme (the AgrOS one,
 * primary #bec4ee), Rubik like the shell, pill buttons and fields, rounded panels.
 * Calamares' object names (view-button-next...) from its own code; its debug window lists the rest.
 */

QWidget {
    font-family: "Rubik", "Noto Sans", sans-serif;
    font-size: 13px;
    color: #e5e4f0;
    background-color: #121318;
    selection-background-color: #bec4ee;
    selection-color: #373e61;
}

QLabel { background: transparent; }
QLabel:disabled { color: #74757f; }
a { color: #bec4ee; }

QDialogButtonBox { dialogbuttonbox-buttons-have-icons: 0; }

/* Buttons: tonal pills; Next and Install filled with the primary colour */
QPushButton {
    background-color: #373a4d;
    color: #bcbed5;
    border: none;
    border-radius: 18px;
    padding: 8px 22px;
    min-height: 20px;
}
QPushButton:hover { background-color: #44475c; }
QPushButton:pressed { background-color: #4f5268; }
QPushButton:disabled { background-color: #1e1f26; color: #74757f; }
QPushButton#view-button-next {
    background-color: #bec4ee;
    color: #373e61;
    font-weight: 500;
}
QPushButton#view-button-next:hover { background-color: #cdd2f3; }
QPushButton#view-button-next:disabled { background-color: #1e1f26; color: #74757f; }
QPushButton#view-button-cancel { background-color: transparent; color: #f97386; }
QPushButton#view-button-cancel:hover { background-color: #2a1b20; }
QPushButton:focus { outline: none; }
#aboutButton, #debugButton { background: transparent; border: none; padding: 4px; }

/* Text fields, lists and drop-downs: the shell's containers, rounded, the primary colour when focused */
QLineEdit, QTextEdit, QPlainTextEdit, QTextBrowser, QSpinBox {
    background-color: #1e1f26;
    border: 1px solid #464750;
    border-radius: 12px;
    padding: 7px 12px;
}
QLineEdit:focus, QTextEdit:focus, QSpinBox:focus { border: 1px solid #bec4ee; }
QComboBox {
    /* a list of 10 under the field, not Qt's own popup: on Wayland that one took the whole list's height (its end off
       the screen) with a white scroll strip on top (the language list) */
    combobox-popup: 0;
    background-color: #1e1f26;
    border: 1px solid #464750;
    border-radius: 12px;
    padding: 6px 12px;
}
QComboBox:hover { border: 1px solid #74757f; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(/usr/share/calamares/branding/agros/arrow-down.svg); width: 14px; height: 14px; }
QComboBox QAbstractItemView {
    background-color: #1e1f26;
    border: 1px solid #464750;
    border-radius: 12px;
    padding: 4px;
    outline: none;
}

QListView, QTreeView, QTableView, QListWidget, QTreeWidget {
    background-color: #181920;
    alternate-background-color: #1e1f26;
    border: 1px solid #24252e;
    border-radius: 14px;
    padding: 4px;
    outline: none;
}
QListView::item, QTreeView::item, QListWidget::item { padding: 5px 8px; border-radius: 8px; }
/* A tree's row is one cell per column: one pill across them, rounded at its ends only (the package list) */
QTreeView::item { border-radius: 0; }
QTreeView::item:last { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
QTreeView::item:only-one { border-radius: 8px; }
QListView::item:hover, QTreeView::item:hover, QListWidget::item:hover { background-color: #24252e; }
QListView::item:selected, QTreeView::item:selected, QListWidget::item:selected {
    background-color: #bec4ee;
    color: #373e61;
}
/* The arrow's place is the pill's rounded left end: Qt fills it as a square of its own otherwise, and draws no arrow
   once it's given a colour (so these arrows) */
QTreeView::branch:adjoins-item { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
QTreeView::branch:hover:adjoins-item { background-color: #24252e; }
QTreeView::branch:selected:adjoins-item { background-color: #bec4ee; }
QTreeView::branch:has-children:closed { image: url(/usr/share/calamares/branding/agros/branch-closed.svg); }
QTreeView::branch:has-children:open { image: url(/usr/share/calamares/branding/agros/branch-open.svg); }
QTreeView::branch:has-children:closed:selected { image: url(/usr/share/calamares/branding/agros/branch-closed-selected.svg); }
QTreeView::branch:has-children:open:selected { image: url(/usr/share/calamares/branding/agros/branch-open-selected.svg); }
QHeaderView::section {
    background-color: #181920;
    color: #aaaab5;
    border: none;
    padding: 6px 8px;
}

/* Check boxes and radio buttons */
QCheckBox, QRadioButton { background: transparent; spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator, QTreeView::indicator, QListView::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #aaaab5;
    background-color: transparent;
}
QCheckBox::indicator, QTreeView::indicator, QListView::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator:checked, QTreeView::indicator:checked, QListView::indicator:checked {
    border: 2px solid #bec4ee;
    background-color: #bec4ee;
    image: url(/usr/share/calamares/branding/agros/check.svg);
}
QRadioButton::indicator:checked {
    border: 2px solid #bec4ee;
    background-color: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
                                      stop: 0 #bec4ee, stop: 0.5 #bec4ee, stop: 0.56 transparent);
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QTreeView::indicator:hover { border-color: #bec4ee; }
QTreeView::indicator:indeterminate { border: 2px solid #bec4ee; background-color: #4a5074; }
/* (on a highlighted row: its box outlined, not lost in the highlight) */
QTreeView::indicator:checked:selected { border-color: #373e61; }

/* Progress: a rounded track and the primary colour, like the shell's sliders */
QProgressBar {
    background-color: #24252e;
    border: none;
    border-radius: 6px;
    height: 12px;
    text-align: center;
    color: #e5e4f0;
}
QProgressBar::chunk { background-color: #bec4ee; border-radius: 6px; }

/* Scroll bars: thin rounded handles */
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle { background-color: #464750; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background-color: #74757f; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { background: none; border: none; }

QToolTip {
    background-color: #24252e;
    color: #e5e4f0;
    border: 1px solid #464750;
    border-radius: 8px;
    padding: 4px 8px;
}
QMenu { background-color: #1e1f26; border: 1px solid #464750; border-radius: 12px; padding: 4px; }
QMenu::item { padding: 6px 16px; border-radius: 8px; }
QMenu::item:selected { background-color: #373a4d; }
QMessageBox, QDialog { background-color: #181920; }
QGroupBox { border: 1px solid #24252e; border-radius: 14px; margin-top: 14px; padding: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; color: #aaaab5; }

/* The install page (its widget named "slideshow"): no square frame round the slideshow and the log (they're tabs of a
   widget whose tabs are hidden); the slideshow draws its own rounded card (show.qml), the log is one like it */
#slideshow QTabWidget::pane { border: none; background: transparent; }
#slideshow QPlainTextEdit, #slideshow QTextEdit { background-color: #181920; border: 1px solid #24252e; border-radius: 18px; }
