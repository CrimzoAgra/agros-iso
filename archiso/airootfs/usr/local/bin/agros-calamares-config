#!/usr/bin/env bash
# AgrOS's settings for CachyOS's installer, made when it starts (calamares-online.sh, after it has put its own in
# /etc/calamares): the package list is AgrOS's (CachyOS's base plus agros-desktop: the ISO's own
# /usr/share/agros/netinstall.yaml, never one fetched: a bad push to main would break every install started after it, and
# Calamares runs a group file's commands as root; any change to it builds a new ISO), so there's no desktop page to pick from;
# greetd is enabled and starts AgrOS's login screen (in the step CachyOS uses for its own greeter, shellprocess@greetd,
# run after the installer has set greetd up; added where CachyOS's settings lack it); AgrOS's branding, name and boot entry;
# and GRUB only, with no bootloader page (the bootloader, pacstrap and grubcfg steps and the partition page set to GRUB).
# Stops with "AgrOS: ..." if a setting didn't apply. Usage: agros-calamares-config [settings.conf [modules dir
# [python modules dir]]]
set -euo pipefail
# (the "AgrOS: " line calamares-online.sh shows in its notification)
fail() { echo "AgrOS: $*"; exit 1; }
# (a command that stops it unchecked, set -e's, said too: else the notification showed the last "AgrOS: " line before
# it, a note such as the room left as CachyOS has it, as the reason)
trap 'fail "a step of its own failed (agros-calamares-config, line $LINENO): an installer file not where it was?"' ERR
settings=${1:-/etc/calamares/settings.conf}
mods=${2:-/etc/calamares/modules}
mkdir -p "$mods"
cat >"$mods/netinstall.conf" <<'CONF'
---
groupsUrl:
 - file:///usr/share/agros/netinstall.yaml
required: true
label:
 sidebar: "Packages"
 title: "AgrOS"
CONF
cat >"$mods/shellprocess_greetd.conf" <<'CONF'
---
dontChroot: false
timeout: 3600
script:
 - command: |
      # The packages' own pacman.conf, resolv.conf and mirror lists, set aside because the live system's (AgrOS's repos,
      # ranked mirrors) were copied over them: six .pacnew files on a new install, nothing in them to merge
      rm -f /etc/pacman.conf.pacnew /etc/resolv.conf.pacnew /etc/pacman.d/*mirrorlist.pacnew
      # The snapshots the install's own package runs made (snap-pac's pre/post pairs): the boot menu's snapshot list
      # starts with the installation's own snapshot alone (taken after this step: AgrOS's snapshot step adds it to the menu)
      # (no dollar signs in this command: Calamares reads one followed by a name as its own variable, and stops the
      # install on one it doesn't know; it has no way to pass a plain one to the shell)
      # (plain numbers only: not the header, the current state 0, or a number with a marker after it. No snapshots
      # folder: not btrfs, nothing to do)
      if snapper --no-dbus -c root --csvout list --columns number,description >/tmp/agros-snapshots 2>/dev/null; then
        grep -v Installation /tmp/agros-snapshots | cut -d, -f1 | grep -x '[1-9][0-9]*' |
          xargs -r snapper --no-dbus -c root delete || echo "AgrOS: the install's snapshots left as they were"
      elif [ -d /.snapshots ]; then
        echo "AgrOS: the install's snapshots not listed, left as they were"
      fi
      rm -f /tmp/agros-snapshots
      # The downloaded packages, once: the install leaves about 4 GB of them in the cache, kept until three newer
      # versions of each come (paccache.timer). Updates download their own
      paccache -rk0 >/dev/null || echo "AgrOS: the package cache left as it was"
      # AgrOS's boot menu (hidden, 1 s, quiet, AgrOS's GRUB theme) and fast splash, now that GRUB is set up: agros-boot's own install ran
      # before /boot/grub existed (boot-menu left it for now), and the installer's grubcfg and plymouthcfg steps set CachyOS's after it.
      # boot-menu keeps CachyOS's settings as grub.agros-orig and notes its run (agros-boot's upgrades don't run it again unchanged);
      # on an AMD GPU splash-theme keeps CachyOS's plain splash, as plymouthcfg chose
      # (timeout 3600, as CachyOS's own steps have: the splash rebuilds both kernels' initramfs, and the boot menu
      # looks for other systems on every disk; cut off, the whole install would fail at its end)
      /usr/lib/agros/boot-menu || echo "AgrOS: the boot menu left as it was"
      /usr/lib/agros/splash-theme || echo "AgrOS: the splash left as it was"
      if [ -f /etc/greetd/caelestia-greeter/greetd-config.toml ]; then
        cp -f /etc/greetd/caelestia-greeter/greetd-config.toml /etc/greetd/config.toml
        chmod 644 /etc/greetd/config.toml
      fi
      # (last: its result is the step's) greetd as the login screen: CachyOS's installer enables it only for noctalia-greeter
      ln -sf /usr/lib/systemd/system/greetd.service /etc/systemd/system/display-manager.service
i18n:
  name: "Configuring the AgrOS login screen..."
CONF
# The installation's snapshot (CachyOS's btrfs_snapshot step: a script of theirs, or on their newer branches their
# installer's own code, gucc, which names it in C++) named AgrOS's, and in GRUB's menu from the first boot: their step
# runs after the boot menu was made, and grub-btrfsd only adds snapshots taken after it starts (once: the installer
# restarted). A step of AgrOS's right after theirs, whichever it is (set up below)
cat >"$mods/shellprocess_agrossnapshot.conf" <<'CONF'
---
dontChroot: false
timeout: 300
script:
 - command: |
      # (no dollar signs, as in the greetd step. Not btrfs, or no snapshot taken: nothing to do)
      if snapper --no-dbus -c root --csvout list --columns number,description >/tmp/agros-snapshots 2>/dev/null; then
        # (none described so: said, as CachyOS may have named it otherwise)
        if grep -x '[1-9][0-9]*,Fresh .* Installation' /tmp/agros-snapshots >/tmp/agros-installation; then
          cut -d, -f1 /tmp/agros-installation |
            xargs -r -I{} snapper --no-dbus -c root modify --description 'Fresh AgrOS Installation' {} ||
            echo "AgrOS: the installation snapshot not renamed"
        else
          echo "AgrOS: no snapshot described as the installation's (Fresh ... Installation): none renamed"
        fi
        rm -f /tmp/agros-installation
        if [ -x /etc/grub.d/41_snapshots-btrfs ] && [ -d /boot/grub ]; then
          grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || echo "AgrOS: the installation snapshot not added to the boot menu"
        fi
      elif [ -d /.snapshots ]; then
        echo "AgrOS: the snapshots not listed: the installation snapshot not renamed, nor added to the boot menu"
      fi
      rm -f /tmp/agros-snapshots
i18n:
  name: "Naming the installation snapshot..."
CONF
# No dollar sign at all in their commands: Calamares reads $name as its own variable (one it doesn't know failed the
# whole install, after the disk was wiped), turns $$ into \$, and tracks quotes without knowing comments, so which ones
# it reads depends on the apostrophes before them. (buildiso.sh checks the same, so such an ISO isn't built)
for f in shellprocess_greetd.conf shellprocess_agrossnapshot.conf; do
    ! grep -n '\$' "$mods/$f" || fail "a dollar sign Calamares would read as its own in $mods/$f"
done
# AgrOS's branding (/usr/share/calamares/branding/agros: its name, logo, colours, its own step bar and stylesheet in
# the desktop's style); AgrOS's name in the install steps that say CachyOS's, and in the computer name it suggests
sed -i 's/^branding: .*/branding: agros/' "$settings"
sed -i -e '/^ *name.*:/s/CachyOS/AgrOS/' -e '/^ *name\[fr\]:/s/pour le AgrOS/pour AgrOS/' -e "/^ *name\\[fr\\]:/s/ de AgrOS/ d'AgrOS/" \
    "$mods"/shellprocess-before-online.conf "$mods"/shellprocess-before.conf 2>/dev/null || true  # (French: "le/de CachyOS")
sed -i 's/template: "cachyos-\${cpu}"/template: "agros-${cpu}"/' "$mods/users.conf" 2>/dev/null || true
# No "Log in automatically" box on the users page, and none chosen: AgrOS's login screen is greetd's, which the
# installer's display manager step doesn't set up, so it would do nothing. Calamares hides it unless displayAutologin
# is true (CachyOS's users.conf has none); kept so if CachyOS turns it on
sed -i -e 's/^\( *displayAuto[Ll]ogin:\).*/\1 false/' -e 's/^\( *doAuto[Ll]ogin:\).*/\1 false/' "$mods/users.conf" 2>/dev/null || true
# The room AgrOS needs, not CachyOS's 8 GB: the welcome page's check, and the least the partition page leaves for the
# new system beside Windows (this plus 2.1 GB) or in place of a partition (plus 0.5 GB). A new install is about 14 GB
# of packages, and about 4 GB more downloaded while it installs (cleared at its end): beside Windows at CachyOS's
# 10 GB it would run out of room halfway, after Windows' partition was shrunk. Not set (CachyOS moved it): said
sed -i 's/^\( *requiredStorage:\).*/\1    20.0/' "$mods/welcome_online.conf" 2>/dev/null || true
grep -q '^ *requiredStorage: *20\.0$' "$mods/welcome_online.conf" 2>/dev/null ||
    echo "AgrOS: the room the installer asks for left as CachyOS has it"
# The boot entry the firmware lists (and GRUB's folder on the boot partition, EFI/AgrOS)
sed -i 's/^efiBootloaderId: .*/efiBootloaderId: "AgrOS"/' "$mods/bootloader.conf" 2>/dev/null || true
# Two scripts of CachyOS's ISO that AgrOS's ISO doesn't have: remove-nvidia (only CachyOS's offline install runs it) and
# dmcheck (it picks the login screen: the greetd step above does that). Neither copied to the new system (each install
# logged "Failed to copy file") nor run there: the cachyos branch's installer runs /usr/local/bin/dmcheck in the new
# system, and missing, it failed the install at its end, after the disk was wiped
# drop_item <file> <path>: the list items naming <path>, with their own keys under them (a command's verbose:, timeout:)
drop_item() {
    [ -f "$1" ] || return 0
    awk -v p="$2" '
        skip && match($0, /^ */) && RLENGTH > ind { next }
        { skip = 0; s = $0; sub(/["\047]$/, "", s) }
        s ~ /^ *- / && length(s) >= length(p) && substr(s, length(s) - length(p) + 1) == p { match(s, /^ */); ind = RLENGTH; skip = 1; next }
        { print }' "$1" >"$1.agros" && cat "$1.agros" >"$1" && rm -f "$1.agros"
}
for f in pacstrap.conf shellprocess.conf; do
    drop_item "$mods/$f" /usr/local/bin/remove-nvidia
    drop_item "$mods/$f" /usr/local/bin/dmcheck
    ! grep -q '/usr/local/bin/\(remove-nvidia\|dmcheck\)' "$mods/$f" 2>/dev/null || fail "remove-nvidia or dmcheck is still in $mods/$f"
done
# And none other the install runs from /usr/local/bin and this ISO lacks (CachyOS's ISO has more there): said now, not
# after the disk was wiped. The steps of settings.conf, and shellprocess.conf (the plain shellprocess step); a command
# allowed to fail (its "-") and the files pacstrap copies (a warning when missing) left out
for f in shellprocess.conf $(sed -n 's/^ *config: *//p' "$settings"); do
    [ -f "$mods/$f" ] || continue
    while read -r x; do
        [ -e "$x" ] || fail "the installer runs $x, which this ISO doesn't have ($mods/$f)"
    done < <(grep -v '^ *#' "$mods/$f" | grep -v '^ *- *\(command: *\)\?["'\'']\?-' |
        sed -n 's|.*\(/usr/local/bin/[^"'\'' ]*\).*|\1|p')
done

# No desktop page: AgrOS is the desktop
sed -i '/^  - packagechooser@desktop$/d' "$settings"
grep -q 'packagechooser@desktop' "$settings" && fail "the desktop page is still in $settings"

# GRUB only, no bootloader page (AgrOS's boot menu, theme and snapshots are GRUB's). The page's choice
# (packagechooser_bootloader, Limine by default) is what the bootloader, pacstrap (its packages) and grubcfg steps read,
# and what picks the partition page's settings (bootloaderOverrides): with no page, the bootloader step is told GRUB,
# the other two take GRUB when nothing was chosen, and the partition page starts on GRUB's settings (the boot partition
# at /boot/efi, 512 MB; Limine's is /boot, the kernels on it, where GRUB's btrfs snapshots can't reach them)
pymods=${3:-/usr/lib/calamares/modules}
sed -i '/^  - packagechooser@bootloader$/d' "$settings"
sed -i -e '/^efiBootLoaderVar:/d' -e 's/^efiBootLoader: .*/efiBootLoader: "grub"/' "$mods/bootloader.conf"
sed -i 's/globalstorage.value("packagechooser_bootloader")$/globalstorage.value("packagechooser_bootloader") or "grub"/' \
    "$pymods/pacstrap/main.py" "$pymods/grubcfg/main.py"
sed -i -e 's|^efiSystemPartition: .*|efiSystemPartition:     "/boot/efi"|' -e 's/^efiSystemPartitionSize: .*/efiSystemPartitionSize:     512M/' \
    -e 's/^allowZfsEncryption: .*/allowZfsEncryption: false/' "$mods/partition.conf"
grep -q 'packagechooser@bootloader' "$settings" && fail "the bootloader page is still in $settings"
grep -qx 'efiBootLoader: "grub"' "$mods/bootloader.conf" && ! grep -q '^efiBootLoaderVar' "$mods/bootloader.conf" ||
    fail "the bootloader step isn't set to GRUB ($mods/bootloader.conf)"
for f in "$pymods/pacstrap/main.py" "$pymods/grubcfg/main.py"; do
    grep -q 'value("packagechooser_bootloader") or "grub"' "$f" || fail "$f doesn't default to GRUB"
done
# Beside Windows, the firmware's fallback loader (EFI/Boot/bootx64.efi, Windows' copy of its boot manager) kept:
# CachyOS's bootloader.conf has GRUB copied over it (installEFIFallback, for the rare firmware that boots nothing else).
# A machine that starts Windows by that path, or whose boot entries were lost (a firmware update, a reset), then came
# to AgrOS (Windows behind Esc in the first second), or with Secure Boot on maybe to nothing (GRUB's copy isn't signed).
# With no Windows on the boot partition (EFI/Microsoft/Boot/bootmgfw.efi), GRUB's copy as before. Not patched
# (CachyOS changed the step): said, the install goes on. Only in install_grub (from its def to the next), the one place
# install_efi_directory_firmware is set, and only with that condition there once: another loader's copy of it would
# fail on a name it doesn't have
bl=$pymods/bootloader/main.py
grub='/^def install_grub(/,/^def /'
plain='^ *if libcalamares\.job\.configuration\.get(fallback, True):$'
win='os.path.exists(os.path.join(install_efi_directory_firmware, "Microsoft", "Boot", "bootmgfw.efi"))'
n=$(sed -n "$grub{\\|$plain|p;}" "$bl" 2>/dev/null | grep -c .) || true
if [[ $n == 1 ]]; then
    sed -i "$grub"'s|^\( *\)if libcalamares.job.configuration.get(fallback, True):$|\1if libcalamares.job.configuration.get(fallback, True) and not '"$win"':|' "$bl" || true
fi
n=$(sed -n "$grub{/\"Microsoft\", \"Boot\", \"bootmgfw.efi\"/p;}" "$bl" 2>/dev/null | grep -c .) || true
[[ $n == 1 ]] || echo "AgrOS: the firmware's fallback loader left to CachyOS's step (GRUB copied over Windows' own)"
grep -q '^efiSystemPartition: *"/boot/efi"' "$mods/partition.conf" && grep -q '^efiSystemPartitionSize: *512M' "$mods/partition.conf" &&
    grep -q '^allowZfsEncryption: false' "$mods/partition.conf" ||
    fail "the partition page isn't on GRUB's boot partition ($mods/partition.conf)"
# Beside Windows: the EFI partition already on the disk used down to 64 MB (efi.minimumSize; Windows makes its own
# 100 MB), not refused below the 512 MB a new one is made. GRUB needs a few MB there, the kernels being on the system's
# partition. (AgrOS's installer, rebuilt in agros's CI, checks this minimum on the install-type page, not the 512 MB;
# Calamares's own floor is 32 MB.) A minimum CachyOS has set already is kept; an efi setting of theirs written another
# way (on one line) too, as it is: the install goes on, only "Install alongside" a small one refused as before
if ! grep -q '^efi:' "$mods/partition.conf"; then
    printf '\nefi:\n  minimumSize: 64M\n' >>"$mods/partition.conf"
elif grep -q '^efi: *$' "$mods/partition.conf" && ! grep -q '^ \+minimumSize:' "$mods/partition.conf"; then
    # (indented as the block's own keys are: YAML takes no other)
    ind=$(sed -n '/^efi: *$/{n;s/^\( *\).*/\1/p;q;}' "$mods/partition.conf")
    sed -i "s/^efi: *\$/&\n${ind:-  }minimumSize: 64M/" "$mods/partition.conf"
fi
grep -q '^ \+minimumSize:' "$mods/partition.conf" || echo "AgrOS: the EFI partition's minimum size left as CachyOS has it"
# The step that sets up the login screen (and the boot menu, splash, snapshots after it): CachyOS's own where it has
# one; its newer branches have no such step (and greetd commented out of displaymanager), so there it's added, before
# the btrfs snapshot, whichever module takes it (a shellprocess script, or gucc on their newer branches), or before the
# clean-up, as CachyOS's older branch has it
# step_at <step>: its line in settings.conf's sequence (none: empty)
step_at() { grep -n -m1 "^ *- $1\$" "$settings" | cut -d: -f1 || true; }
snapshot='[^ @]*@btrfs_snapshot'
if ! grep -q '^ *- shellprocess@greetd$' "$settings"; then
    grep -q '^- id: *greetd$' "$settings" ||
        sed -i 's/^- id: *cleanup_calamares$/- id:       greetd\n  module:   shellprocess\n  config:   shellprocess_greetd.conf\n\n&/' "$settings"
    if [[ -n $(step_at "$snapshot") ]]; then
        sed -i "s/^\\( *\\)- $snapshot\$/\\1- shellprocess@greetd\\n&/" "$settings"
    else
        sed -i 's/^  - shellprocess@cleanup_calamares$/  - shellprocess@greetd\n&/' "$settings"
    fi
fi
grep -q '^ *- shellprocess@greetd$' "$settings" && grep -q '^- id: *greetd$' "$settings" ||
    fail "the installer's greetd step couldn't be set up ($settings)"
# (before the snapshot, or its clean-up of the install's snapshots would delete it, and it wouldn't hold the login screen)
s=$(step_at "$snapshot")
[[ -z $s || $(step_at shellprocess@greetd) -lt $s ]] || fail "the installer's greetd step is after the btrfs snapshot ($settings)"
# AgrOS's snapshot step (above) right after the snapshot; none to name without it, said
if [[ -n $s ]]; then
    grep -q '^- id: *agrossnapshot$' "$settings" ||
        sed -i 's/^- id: *greetd$/- id:       agrossnapshot\n  module:   shellprocess\n  config:   shellprocess_agrossnapshot.conf\n\n&/' "$settings"
    [[ -n $(step_at shellprocess@agrossnapshot) ]] ||
        sed -i "s/^\\( *\\)- $snapshot\$/&\\n\\1- shellprocess@agrossnapshot/" "$settings"
    a=$(step_at shellprocess@agrossnapshot) s=$(step_at "$snapshot")
    [[ -n $a && $a -gt $s ]] && grep -q '^- id: *agrossnapshot$' "$settings" ||
        fail "the installer's step naming the installation snapshot couldn't be set up after it ($settings)"
else
    echo "AgrOS: no btrfs snapshot step in $settings: no installation snapshot to name"
fi
# The upstream gate for the install (agros-gate-install, on the live system: the ISO's own copy of Hyprland and its
# libraries installed when the newest the install downloaded isn't approved yet), after the packages, before the step
# above. ${ROOT}: one of Calamares's own variables, the installed system's root. An hour, as CachyOS's own steps have:
# its pacman is never cut off (a set half installed). Its failure, or a timeout, never the
# install's ("-": the install goes on with the newest, held by its updates until approved). What it did: in the new
# system's /var/log/agros-gate-install.log (it writes that itself) and the live session's installer log (verbose)
cat >"$mods/shellprocess_agrosgate.conf" <<'CONF'
---
dontChroot: true
timeout: 3600
script:
 - command: "-/usr/local/bin/agros-gate-install ${ROOT}"
   verbose: true
i18n:
  name: "Checking Hyprland against AgrOS's approved versions..."
CONF
grep -q '^- id: *agrosgate$' "$settings" ||
    sed -i 's/^- id: *greetd$/- id:       agrosgate\n  module:   shellprocess\n  config:   shellprocess_agrosgate.conf\n\n&/' "$settings"
grep -q '^ *- shellprocess@agrosgate$' "$settings" ||
    sed -i 's/^\( *\)- shellprocess@greetd$/\1- shellprocess@agrosgate\n&/' "$settings"
grep -q '^ *- shellprocess@agrosgate$' "$settings" && grep -q '^- id: *agrosgate$' "$settings" ||
    fail "the installer's upstream gate step couldn't be set up ($settings)"
# Any other Python step reading the bootloader page's choice (none: no such page) than those that cope with it
others=$(grep -rl 'packagechooser_bootloader' "$pymods" --include=*.py | grep -v '/\(pacstrap\|grubcfg\)/main\.py$' || true)
[[ -z $others ]] || fail "installer steps reading the bootloader choice: $others"
echo "AgrOS: installer configured."
