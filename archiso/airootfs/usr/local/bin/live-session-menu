#!/bin/sh
# Live session: the Super menu with only what the live session is for (the installer, a terminal, files, a browser, the
# partition editor), not every app of the installed system, and no pinned apps. Caelestia's own setting
# (launcher.hiddenApps: one pattern hiding every other app), added to the installed system's settings file the live user
# has, which it follows as it changes. Through agros-scripts' json-edit, as every writer of that file: under its lock,
# made when missing, tried again while Caelestia is halfway through rewriting it (never started again from {}). Run
# when the live session starts (its autostart entry)
f=$HOME/.config/caelestia/shell.json
mkdir -p "${f%/*}"
exec /usr/lib/agros/bin/json-edit "$f" --indent 4 \
    '.launcher.hiddenApps = ["^(?!(agros-install|foot|thunar|librewolf|gparted)$).*$"] | .launcher.favouriteApps = []'
